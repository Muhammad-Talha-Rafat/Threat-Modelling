            "id": "918dd66f-0191-4b63-a095-2e534ef74d64",
            "data": {
              "type": "tm.Process",
              "name": "Web\nServer",
              "description": "",
              "outOfScope": false,
              "isTrustBoundary": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": false,
              "privilegeLevel": "",
              "threats": [
                {
                  "id": "a7dbbe7b-812d-4047-b1dd-c7e45d3ac5c4",
                  "title": "Credential Spoofing via Stolen Session Token",
                  "status": "Open",
                  "severity": "High",
                  "type": "Spoofing",
                  "description": "An attacker who obtains a valid session token can impersonate a legitimate user by replaying the token in subsequent requests. The web server cannot distinguish the attacker from the real user, granting unauthorized access.",
                  "mitigation": "Implement secure, HttpOnly, and SameSite cookie flags for session tokens. Enforce short session expiry and regenerate tokens after login. Use HTTPS to prevent token interception in transit.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": ""
                },
                {
                  "id": "8d341a1a-c912-44f8-b962-a918bfa9a2cc",
                  "title": "Tampering with Stored Credentials",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "An attacker with unauthorized database access could modify stored password hashes or replace them with known values, allowing them to log in as any user without knowing the original password.",
                  "mitigation": "Apply strict database access controls so only the web server process can query the credentials table. Use strong hashing algorithms (bcrypt or Argon2) with salting. Enable database audit logging to detect unauthorized modifications.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": ""
                },
                {
                  "id": "66b82678-ff2b-40be-a566-09fc5a13e23e",
                  "title": "Sensitive Credentials Exposed in Transit",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information disclosure",
                  "description": "If the connection between the user and web server is downgraded from HTTPS to HTTP through a man-in-the-middle attack, login credentials (username and password) transmitted in the request body can be intercepted and read in plaintext.",
                  "mitigation": "Enforce HTTPS using HTTP Strict Transport Security (HSTS) headers to prevent protocol downgrade attacks. Ensure TLS 1.2 or higher is used. Never transmit credentials over unencrypted channels.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": ""
                },
                {
                  "id": "5ef5fd4b-12f6-4068-8871-41e51a8cc195",
                  "title": "Brute Force Attack on Login Endpoint",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Denial of service",
                  "description": "An attacker can flood the login endpoint with thousands of automated requests attempting different password combinations. This exhausts server resources, making the authentication service unavailable to legitimate users, and may also succeed in guessing weak passwords.",
                  "mitigation": "Implement account lockout after a defined number of failed attempts (e.g. 5). Apply rate limiting on the login endpoint per IP address. Use CAPTCHA to distinguish human users from automated bots. Monitor and alert on unusual login attempt volumes.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 4,
                  "score": ""
                }
              ],
              "threatFrequency": {
                "spoofing": 2,
                "tampering": 1,
                "repudiation": 0,
                "informationDisclosure": 1,
                "denialOfService": 1,
                "elevationOfPrivilege": 0
              }
            }
