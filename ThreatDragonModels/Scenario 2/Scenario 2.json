              "threats": [
                {
                  "id": "81ba7df6-dfc1-4449-bca0-7b549fd3d5f2",
                  "title": "Transaction Amount Tampering in Transit",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "An attacker performing a man-in-the-middle attack could intercept payment requests between the backend and payment gateway and modify the transaction amount or recipient details before they reach the gateway, resulting in fraudulent charges.",
                  "mitigation": "Enforce TLS encryption on all communication between the backend and payment gateway. Implement request signing using HMAC so the gateway can verify the integrity of every request. Never transmit payment data over unencrypted channels.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": ""
                },
                {
                  "id": "4eff9378-7e0a-4123-a6b7-9d17c8fca910",
                  "title": "API Key Exposure in Payment Requests",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information disclosure",
                  "description": "If API keys used to authenticate with the payment gateway are hardcoded in the application source code, logged in server logs, or transmitted insecurely, an attacker who gains access to these keys can make unauthorized payment requests directly to the gateway, bypassing the platform entirely.",
                  "mitigation": "Store API keys in environment variables or a dedicated secrets management service such as HashiCorp Vault or AWS Secrets Manager. Never hardcode credentials in source code. Restrict API key permissions to the minimum required scope and rotate keys regularly. Ensure API keys are never written to application logs.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
                  "score": ""
                }
